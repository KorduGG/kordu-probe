---
type Props = {
  heading?: string;
  summary?: string;
  compact?: boolean;
  showCommands?: boolean;
};

const {
  heading = "Connectivity check",
  summary = "Run a public connectivity check for hostnames, IPs, ports, DNS, and web reachability.",
  compact = false,
  showCommands = false
} = Astro.props;

const configuredSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

if (import.meta.env.PROD && !configuredSiteKey) {
  throw new Error("PUBLIC_TURNSTILE_SITE_KEY is required for production web builds.");
}

const siteKey = configuredSiteKey ?? "1x00000000000000000000AA";
const handoffPath = "/port-checker/";

const quickPills: { port: number; service: string }[] = [
  { port: 22, service: "SSH" },
  { port: 80, service: "HTTP" },
  { port: 443, service: "HTTPS" },
  { port: 3389, service: "RDP" },
  { port: 5432, service: "Postgres" },
  { port: 25565, service: "Minecraft" }
